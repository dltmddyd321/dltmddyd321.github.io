---
import BaseLayout from './BaseLayout.astro';
import { categoryLabel } from '../lib/categories';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags: string[];
}

const { title, description, pubDate, category, tags } = Astro.props;
const dateStr = pubDate.toISOString().slice(0, 10);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  inLanguage: 'ko-KR',
  author: { '@type': 'Person', name: SITE.author, url: SITE.url },
  publisher: { '@type': 'Person', name: SITE.author, url: SITE.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(Astro.url.pathname, SITE.url).href },
  image: new URL(SITE.ogImage, SITE.url).href,
  articleSection: categoryLabel(category),
  keywords: tags.join(', '),
};
---

<BaseLayout
  title={title}
  description={description}
  statusLine={`$ cat ./posts/${category}/*.md`}
  ogType="article"
  publishedDate={pubDate}
  tags={tags}
  jsonLd={jsonLd}
>
  <article class="post" data-pagefind-body>
    <header class="post-header">
      <p class="kicker mono">&gt; {categoryLabel(category)}</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </header>

    <div class="post-grid">
      <aside class="side mono" data-pagefind-ignore>
        <div class="side-block">
          <span class="side-label">date</span>
          <span>{dateStr}</span>
        </div>
        <div class="side-block">
          <span class="side-label">category</span>
          <a class="chip" href={`/category/${category}`}>{categoryLabel(category)}</a>
        </div>
        {tags.length > 0 && (
          <div class="side-block">
            <span class="side-label">tags</span>
            <div class="tag-list">
              {tags.map((tag: string) => <a class="tag" href={`/tag/${tag}`}>#{tag}</a>)}
            </div>
          </div>
        )}
      </aside>

      <div class="content">
        <slot />
      </div>
    </div>

    <footer class="post-footer">
      <a href="/">&larr; 목록으로</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    padding: 8px 0 28px;
    border-bottom: 1px solid var(--border);
  }

  .kicker {
    color: var(--accent);
    font-size: 0.8rem;
    margin: 0 0 12px;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.3;
    margin: 0 0 14px;
  }

  .lede {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 60ch;
    margin: 0;
  }

  .post-grid {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 40px;
    padding-top: 32px;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 0.78rem;
  }

  .side-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .side-label {
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
  }

  .tag-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tag {
    color: var(--text-muted);
  }

  .content {
    font-size: 1.05rem;
    max-width: 68ch;
  }

  .content :global(h2) {
    font-size: 1.4rem;
    margin: 2em 0 0.6em;
  }

  .content :global(h3) {
    font-size: 1.15rem;
    margin: 1.8em 0 0.5em;
  }

  .content :global(p) {
    margin: 0 0 1.2em;
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 0 0 1.2em;
    padding-left: 1.4em;
  }

  .post-footer {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  @media (max-width: 720px) {
    .post-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .side {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 24px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border);
    }
  }
</style>
