---
import BaseLayout from './BaseLayout.astro';
import { categoryLabel } from '../lib/categories';
import { SITE, GISCUS } from '../lib/site';

const giscusEnabled = GISCUS.repoId !== 'CHANGE_ME' && GISCUS.categoryId !== 'CHANGE_ME';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags: string[];
  /** Short teaser Claude writes when authoring a post — rendered as a
   * distinct banner, separate from the human-written `description` lede. */
  aiPreview?: string;
  /** Repo-relative path to this post's source file — used by the edit/delete
   * controls, which only reveal themselves once a valid admin token is
   * present in localStorage (see the script below). */
  sourcePath: string;
}

const { title, description, pubDate, category, tags, aiPreview, sourcePath } = Astro.props;
const dateStr = pubDate.toISOString().slice(0, 10);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  inLanguage: 'ko-KR',
  author: { '@type': 'Person', name: SITE.author, url: SITE.url },
  publisher: { '@type': 'Person', name: SITE.author, url: SITE.url },
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(Astro.url.pathname, SITE.url).href },
  image: new URL(SITE.ogImage, SITE.url).href,
  articleSection: categoryLabel(category),
  keywords: tags.join(', '),
};
---

<BaseLayout
  title={title}
  description={description}
  statusLine={`$ cat ./posts/${category}/*.md`}
  ogType="article"
  publishedDate={pubDate}
  tags={tags}
  jsonLd={jsonLd}
>
  <article class="post" data-pagefind-body data-pagefind-meta="kind:글">
    <header class="post-header">
      <p class="kicker mono">&gt; {categoryLabel(category)}</p>
      <h1>{title}</h1>

      {aiPreview && (
        <aside class="ai-preview bracketed">
          <span class="ai-preview-tag mono">✦ AI Preview</span>
          <p>{aiPreview}</p>
        </aside>
      )}
    </header>

    <div class="post-grid">
      <aside class="side mono" data-pagefind-ignore>
        <div class="side-block">
          <span class="side-label">date</span>
          <span>{dateStr}</span>
        </div>
        <div class="side-block">
          <span class="side-label">category</span>
          <a class="chip" href={`/category/${category}`}>{categoryLabel(category)}</a>
        </div>
        {tags.length > 0 && (
          <div class="side-block">
            <span class="side-label">tags</span>
            <div class="tag-list">
              {tags.map((tag: string) => <a class="tag" href={`/tag/${tag}`}>#{tag}</a>)}
            </div>
          </div>
        )}
      </aside>

      <div class="content">
        <slot />
      </div>
    </div>

    <footer class="post-footer">
      <a href="/">&larr; 목록으로</a>
      <div class="post-actions">
        <a
          href={`/write?edit=${encodeURIComponent(sourcePath)}`}
          id="edit-link"
          class="pill mono"
          hidden
        >
          ✎ 수정
        </a>
        <button
          type="button"
          id="delete-btn"
          class="pill mono"
          data-path={sourcePath}
          data-title={title}
          hidden
        >
          🗑 삭제
        </button>
        <button type="button" id="share-btn" class="pill mono" data-share-title={title}>공유하기 ↗</button>
      </div>
    </footer>

    {giscusEnabled && (
      <section class="comments">
        <h2 class="comments-title mono">Comments</h2>
        <script
          is:inline
          src="https://giscus.app/client.js"
          data-repo={GISCUS.repo}
          data-repo-id={GISCUS.repoId}
          data-category={GISCUS.category}
          data-category-id={GISCUS.categoryId}
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="transparent_dark"
          data-lang="ko"
          crossorigin="anonymous"
          async
        />
      </section>
    )}
  </article>
</BaseLayout>

<script>
  import { OWNER, REPO, BRANCH, TOKEN_KEY, API_ROOT, ghHeaders, validateToken } from '../lib/adminAuth';

  const editLink = document.getElementById('edit-link') as HTMLAnchorElement | null;
  const deleteBtn = document.getElementById('delete-btn') as HTMLButtonElement | null;

  // Cheap presence check only — same as the header's Write link. The real
  // authorization check runs against GitHub when delete is actually clicked.
  const storedToken = localStorage.getItem(TOKEN_KEY);
  if (storedToken) {
    editLink?.removeAttribute('hidden');
    deleteBtn?.removeAttribute('hidden');
  }

  deleteBtn?.addEventListener('click', async () => {
    const path = deleteBtn.dataset.path;
    const title = deleteBtn.dataset.title ?? '이 글';
    if (!path) return;
    if (!confirm(`정말 "${title}"을(를) 삭제하시겠습니까? 되돌릴 수 없습니다.`)) return;

    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) {
      alert('로그인이 만료되었습니다. /write에서 다시 로그인해주세요.');
      return;
    }

    deleteBtn.disabled = true;
    deleteBtn.textContent = '삭제 중…';
    try {
      await validateToken(token);

      const getRes = await fetch(`${API_ROOT}/repos/${OWNER}/${REPO}/contents/${path}`, {
        headers: ghHeaders(token),
      });
      if (!getRes.ok) throw new Error(`http-${getRes.status}`);
      const file = (await getRes.json()) as { sha: string };

      const delRes = await fetch(`${API_ROOT}/repos/${OWNER}/${REPO}/contents/${path}`, {
        method: 'DELETE',
        headers: { ...ghHeaders(token), 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message: `fix: delete post "${title}"`,
          sha: file.sha,
          branch: BRANCH,
        }),
      });
      if (!delRes.ok) throw new Error(`http-${delRes.status}`);

      alert('삭제되었습니다. 배포가 끝나면 목록에서 사라집니다.');
      location.href = '/';
    } catch {
      alert('삭제에 실패했습니다.');
      deleteBtn.disabled = false;
      deleteBtn.textContent = '🗑 삭제';
    }
  });
</script>

<script>
  const shareBtn = document.getElementById('share-btn') as HTMLButtonElement | null;

  shareBtn?.addEventListener('click', async () => {
    const shareData = {
      title: shareBtn.dataset.shareTitle ?? document.title,
      url: location.href,
    };

    if (navigator.share) {
      try {
        await navigator.share(shareData);
      } catch {
        // User cancelled the share sheet — not an error.
      }
      return;
    }

    try {
      await navigator.clipboard.writeText(shareData.url);
      const original = shareBtn.textContent;
      shareBtn.textContent = '링크 복사됨!';
      setTimeout(() => {
        shareBtn.textContent = original;
      }, 1500);
    } catch {
      alert(shareData.url);
    }
  });
</script>

<script>
  // Only pay for mermaid.js on posts that actually use it. Loaded as a full
  // URL so Vite treats it as an external runtime import rather than trying
  // to resolve/bundle it (same reasoning as the pagefind import in search.astro).
  interface MermaidApi {
    initialize: (config: Record<string, unknown>) => void;
    run: () => Promise<void>;
  }

  if (document.querySelector('.mermaid')) {
    const importUnanalyzed = new Function('specifier', 'return import(specifier)') as (
      specifier: string,
    ) => Promise<{ default: MermaidApi }>;

    importUnanalyzed('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')
      .then(({ default: mermaid }) => {
        // Mirrors the dark palette in global.css — mermaid has no CSS-variable
        // theming API, so the hex values are duplicated here by necessity.
        mermaid.initialize({
          startOnLoad: false,
          theme: 'dark',
          themeVariables: {
            background: '#0b0c0a',
            primaryColor: '#1a1c16',
            primaryTextColor: '#ece9df',
            primaryBorderColor: '#e0a458',
            lineColor: '#8f9285',
            fontFamily: 'ui-monospace, SF Mono, JetBrains Mono, Menlo, Consolas, monospace',
          },
        });
        return mermaid.run();
      })
      .catch((err) => {
        // eslint-disable-next-line no-console
        console.error('mermaid failed to load', err);
      });
  }
</script>

<style>
  /* Header and grid share one width so the title lines up with the meta rail
     instead of stretching across the full shell. */
  .post {
    --rail: minmax(140px, 180px);
    --post-gap: clamp(24px, 4vw, 48px);
    max-width: calc(180px + var(--post-gap) + var(--prose-max));
    margin-inline: auto;
  }

  .post-header {
    padding: 8px 0 28px;
    border-bottom: 1px solid var(--border);
  }

  .kicker {
    color: var(--accent);
    font-size: 0.8rem;
    margin: 0 0 12px;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    line-height: 1.3;
    margin: 0 0 14px;
  }

  /* Square corners here, unlike the site's other boxes — crop marks only read
     as registration marks against a hard corner, not a rounded one. */
  .ai-preview {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 20px;
    padding: 16px 20px;
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
  }

  .ai-preview-tag {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .ai-preview p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text);
  }

  /* Meta rail + prose, capped at the reading measure and centred as a pair so
     the extra room on a wide shell falls outside rather than stretching lines. */
  .post-grid {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, var(--prose-max));
    gap: var(--post-gap);
    padding-top: 32px;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 0.78rem;
  }

  .side-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .side-label {
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
  }

  .tag-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .tag {
    color: var(--text-muted);
  }

  .content {
    font-size: 1.05rem;
    max-width: var(--prose-max);
    min-width: 0;
  }

  .content :global(h2) {
    font-size: 1.4rem;
    margin: 2em 0 0.6em;
  }

  .content :global(h3) {
    font-size: 1.15rem;
    margin: 1.8em 0 0.5em;
  }

  .content :global(p) {
    margin: 0 0 1.2em;
  }

  /* Editorial drop cap on the opening paragraph only. Korean syllables are
     full-width and visually heavier than a Latin capital, so the scale is
     kept modest — a 3-line cap that works for "A" swallows "안". */
  .content :global(> p:first-child::first-letter) {
    float: left;
    margin: 0.08em 0.12em 0 0;
    font-size: 2.8em;
    line-height: 0.86;
    font-weight: 800;
    color: var(--accent);
  }

  .content :global(ul),
  .content :global(ol) {
    margin: 0 0 1.2em;
    padding-left: 1.4em;
  }

  .content :global(.mermaid) {
    display: flex;
    justify-content: center;
    margin: 1.6em 0;
    padding: 16px;
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .content :global(.video-embed) {
    position: relative;
    aspect-ratio: 16 / 9;
    margin: 1.6em 0;
    border-radius: 8px;
    overflow: hidden;
  }

  .content :global(.video-embed iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .content :global(.link-preview-card) {
    display: flex;
    gap: 16px;
    margin: 1.6em 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .content :global(.link-preview-card:hover) {
    border-color: var(--accent-line);
    text-decoration: none;
  }

  .content :global(.link-preview-image) {
    flex-shrink: 0;
    width: 160px;
    background-color: var(--surface-2);
    background-size: cover;
    background-position: center;
  }

  .content :global(.link-preview-body) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-width: 0;
    padding: 12px 16px 12px 0;
  }

  .content :global(.link-preview-domain) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .content :global(.link-preview-title) {
    font-weight: 700;
    font-size: 0.98rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .content :global(.link-preview-desc) {
    font-size: 0.85rem;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  @media (max-width: 480px) {
    .content :global(.link-preview-card) {
      flex-direction: column;
    }

    .content :global(.link-preview-image) {
      width: 100%;
      height: 140px;
    }
  }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .post-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* The one place a pill deviates from the shared hover accent — delete is
     destructive, so its hover state reads as a warning instead. */
  #delete-btn:hover {
    border-color: #d9534f;
    color: #d9534f;
  }

  .comments {
    max-width: var(--prose-max);
    margin: 40px auto 0;
  }

  .comments-title {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0 0 16px;
  }

  /* Keeping the rail below this squeezes prose under ~35 Korean chars a line,
     which reads choppy — give tablets the full width instead. */
  @media (max-width: 820px) {
    .post-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .side {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 24px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border);
    }
  }
</style>
