---
import '../styles/global.css';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  /** Replaces the whole <title> instead of appending the site name. */
  fullTitle?: string;
  description?: string;
  statusLine?: string;
  /** 'article' for blog posts, 'website' for everything else. */
  ogType?: 'website' | 'article';
  publishedDate?: Date;
  tags?: string[];
  /** Thin/duplicate pages that shouldn't compete in search results. */
  noindex?: boolean;
  /** Extra JSON-LD structured data for this page. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  fullTitle,
  description = SITE.description,
  statusLine = '$ tail -f blog.md',
  ogType = 'website',
  publishedDate,
  tags = [],
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = fullTitle ?? (title ? `${title} · ${SITE.name}` : SITE.name);
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(SITE.ogImage, SITE.url).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- 네이버 서치어드바이저 소유확인 (구글은 public/google*.html 파일 방식) -->
    <meta name="naver-site-verification" content="b3b265c613ed28a6627b35564d19c1c8a998bb85" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}
    {ogType === 'article' && <meta property="article:author" content={SITE.author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.name}
      href={new URL('/rss.xml', SITE.url).href}
    />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    )}
  </head>
  <body>
    <div class="wrap">
      <header class="site-header">
        <a class="logo" href="/">
          <span class="mono">~/</span>이승용<span class="mono">.log</span>
        </a>
        <nav>
          <a href="/">Posts</a>
          <a href="/category/insight">Insight</a>
          <a href="/category/dev-log">Dev Log</a>
          <a href="/category/archive">Archive</a>
          <a href="/category/ai-news">AI News</a>
          <a href="/tags">Tags</a>
          <a href="/tistory">예전 글</a>
          <a href="/about">About</a>
        </nav>
        <a class="search-link mono" href="/search" aria-label="검색">$ /</a>
      </header>
      <div class="status-line mono">
        <span class="prompt">{statusLine}</span>
        <span class="rss"><a href="/rss.xml">rss ↗</a></span>
      </div>
      <main>
        <slot />
      </main>
      <footer class="mono">
        <span>© {new Date().getFullYear()} 이승용</span>
        <span class="muted">·</span>
        <a href="https://github.com/dltmddyd321" target="_blank" rel="noopener">github ↗</a>
      </footer>
    </div>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 32px 0 20px;
  }

  .logo {
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .logo:hover {
    text-decoration: none;
    color: var(--accent);
  }

  .logo .mono {
    color: var(--text-muted);
    font-size: 0.85em;
  }

  nav {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  nav a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .search-link {
    flex-shrink: 0;
    font-size: 0.82rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 9px;
  }

  .search-link:hover {
    color: var(--accent);
    border-color: var(--accent-line);
    text-decoration: none;
  }

  .status-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 10px 0;
    margin-bottom: 8px;
  }

  .status-line .prompt::before {
    content: '';
  }

  .status-line a {
    color: var(--text-muted);
  }

  .status-line a:hover {
    color: var(--accent);
  }

  main {
    min-height: 60vh;
    padding: 40px 0;
  }

  footer {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 0.75rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
    padding: 20px 0 48px;
  }

  @media (max-width: 720px) {
    nav {
      gap: 12px;
    }
  }
</style>
