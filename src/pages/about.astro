    font-weight: 700;
    margin: 0 0 14px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .a-rows {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .a-col h4 {
    margin: 0 0 8px;
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .a-col ul,
  .etc-list {
    margin: 0;
    padding-left: 18px;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .a-col li,
  .etc-list li {
    margin: 6px 0;
  }

  .accordion {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin: 12px 0;
    overflow: clip;
  }

  .accordion summary {
    list-style: none;
    cursor: pointer;
    padding: 16px 18px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
  }

  .accordion summary::-webkit-details-marker {
    display: none;
  }

  .chevron {
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
    border: solid var(--accent);
    border-width: 0 2px 2px 0;
    transform: rotate(-45deg);
    transition: transform 0.18s ease;
  }

  .accordion[open] .chevron {
    transform: rotate(45deg);
  }

  .accordion .content {
    border-top: 1px solid var(--border);
    padding: 4px 18px 20px;
  }

  .accordion .content p {
    margin: 12px 0;
    color: var(--text-muted);
  }

  .plain-list {
    margin: 0;
    padding-left: 18px;
  }

  .plain-list li {
    margin: 8px 0;
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .a-rows {
      grid-template-columns: 1fr;
    }
  }
</style>
