    font-size: 0.82rem;
  }

  .a-grid {
    display: grid;
    gap: 16px;
  }

  .a-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px;
  }

  .a-title {
