    font-size: 0.78rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .facts ul {
    margin: 0;
    padding-left: 18px;
  }

  .facts li {
    margin: 6px 0;
  }

