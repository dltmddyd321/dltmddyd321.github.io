---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, CATEGORY_KEYS } from '../lib/categories';

const OWNER = 'dltmddyd321';
const REPO = 'dltmddyd321.github.io';
---

<BaseLayout
  title="Write"
  description="글쓰기 도구 (관리자 전용)."
  statusLine="$ git commit -m 'new post'"
  noindex
>
  <section class="hero">
    <p class="kicker mono">&gt; write</p>
    <h1>새 글 작성</h1>
    <p class="muted">
      GitHub Personal Access Token으로 인증한 뒤, 이 저장소의 <code>main</code> 브랜치에 직접 커밋합니다.
      커밋되면 기존 배포 워크플로가 자동으로 실행됩니다.
    </p>
  </section>

  <section id="gate" class="panel">
    <h2>로그인</h2>
    <p class="muted">
      이 저장소(<code>{OWNER}/{REPO}</code>)에 대한 <strong>Contents: Read and write</strong> 권한을 가진
      fine-grained personal access token이 필요합니다.
      <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">
        토큰 발급 페이지 ↗
      </a>
      에서 이 저장소만 선택해 발급하세요. 토큰은 이 브라우저의 localStorage에만 저장되고 어디로도 전송되지 않습니다
      (GitHub API 호출 시에만 사용).
    </p>
    <form id="gate-form">
      <input
        type="password"
        id="token-input"
        placeholder="github_pat_..."
        autocomplete="off"
        spellcheck="false"
        required
      />
      <button type="submit" id="gate-submit">확인</button>
    </form>
    <p class="status muted mono" id="gate-status" hidden></p>
  </section>

  <section id="editor" class="panel" data-kind="post" hidden>
    <div class="editor-topbar">
      <span class="muted mono" id="whoami"></span>
      <button type="button" class="linklike" id="logout">로그아웃</button>
    </div>

    <div class="kind-row" role="radiogroup" aria-label="작성 종류">
      <button type="button" class="pill mono kind-btn is-on" data-kind="post">글</button>
      <button type="button" class="pill mono kind-btn" data-kind="note">메모</button>
      <span class="muted kind-hint" id="kind-hint">제목·카테고리가 있는 정식 글입니다.</span>
    </div>

    <div class="post-select-row post-only">
      <label>
        <span id="select-label">글 선택</span>
        <select id="post-select">
          <option value="">— 새 글 작성 —</option>
        </select>
      </label>
      <span class="muted mono" id="load-status"></span>
    </div>

    <div class="fields post-only">
      <label>
        제목
        <input type="text" id="f-title" required />
      </label>
      <label>
        요약 (목록/RSS 노출)
        <input type="text" id="f-description" required />
      </label>
      <div class="fields-row">
        <label>
          날짜
          <input type="date" id="f-date" required />
        </label>
        <label>
          카테고리
          <select id="f-category">
            {CATEGORY_KEYS.map((key) => <option value={key}>{CATEGORIES[key].label}</option>)}
          </select>
        </label>
      </div>
      <label>
        URL 슬러그 <span class="hint-inline">비워두면 제목에서 자동 생성 (한글 제목은 자동 생성이 안 되니 직접 입력)</span>
        <input type="text" id="f-slug" placeholder="ai-rewrite-prompt" spellcheck="false" />
      </label>
      <label>
        태그 (쉼표로 구분)
        <input type="text" id="f-tags" placeholder="kotlin, coroutine" />
      </label>
      <label class="checkbox">
        <input type="checkbox" id="f-draft" />
        초안으로 저장 (배포에서 제외)
      </label>
    </div>

    <div class="toolbar mono post-only" role="toolbar" aria-label="서식">
      <button type="button" data-action="bold" title="굵게"><strong>B</strong></button>
      <button type="button" data-action="h2" title="큰 제목">H2</button>
      <button type="button" data-action="h3" title="중간 제목">H3</button>
      <button type="button" data-action="h4" title="작은 제목">H4</button>
      <button type="button" data-action="code-inline" title="인라인 코드">{'`code`'}</button>
      <button type="button" data-action="code-block" title="코드 블록">{'```'}</button>
      <button type="button" data-action="paragraph" title="문단 나누기">¶</button>
      <button type="button" id="image-btn" title="이미지 삽입">🖼 이미지</button>
      <input type="file" id="image-input" accept="image/*" hidden />
      <button type="button" id="youtube-btn" title="유튜브 영상 삽입">▶ 유튜브</button>
      <button type="button" id="mermaid-btn" title="Mermaid 다이어그램 삽입">◇ 다이어그램</button>
      <button type="button" id="link-preview-btn" title="링크 미리보기 카드 삽입">🔗 링크 미리보기</button>
    </div>

    <textarea id="f-body" class="mono" rows="20" placeholder="마크다운으로 본문을 작성하세요…"></textarea>

    <p class="counter mono muted" id="body-count" aria-live="polite">0자</p>

    <div class="publish-row">
      <button type="button" id="publish" class="primary">발행하기</button>
      <p class="status muted mono" id="publish-status"></p>
    </div>
  </section>
</BaseLayout>

<script>
  import { OWNER, REPO, BRANCH, TOKEN_KEY, API_ROOT, ghHeaders, validateToken } from '../lib/adminAuth';

  const gate = document.getElementById('gate') as HTMLElement;
  const gateForm = document.getElementById('gate-form') as HTMLFormElement;
  const tokenInput = document.getElementById('token-input') as HTMLInputElement;
  const gateStatus = document.getElementById('gate-status') as HTMLElement;
  const gateSubmit = document.getElementById('gate-submit') as HTMLButtonElement;

  const editor = document.getElementById('editor') as HTMLElement;
  const whoami = document.getElementById('whoami') as HTMLElement;
  const logoutBtn = document.getElementById('logout') as HTMLButtonElement;

  const postSelect = document.getElementById('post-select') as HTMLSelectElement;
  const loadStatus = document.getElementById('load-status') as HTMLElement;
  const kindHint = document.getElementById('kind-hint') as HTMLElement;
  const kindButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.kind-btn'),
  );
  const postOnlyFields = Array.from(document.querySelectorAll<HTMLElement>('.post-only'));

  /**
   * Posts and notes are the same editor with different frontmatter — a note is
   * just a body and a timestamp, so the title/description/category fields are
   * hidden rather than duplicated into a second page.
   */
  type Kind = 'post' | 'note';
  const DIRS: Record<Kind, string> = {
    post: 'src/content/posts',
    note: 'src/content/notes',
  };
  let kind: Kind = 'post';
  // Non-null while an existing post is loaded — publish() then updates that
  // file in place (with its sha) instead of creating a new one.
  let editingPath: string | null = null;
  let editingSha: string | null = null;
  // The loaded post's pubDate verbatim, so re-saving an edit keeps its original
  // publish time (and thus its feed position) instead of restamping it.
  let editingPubDate: string | null = null;
  /** Unmanaged frontmatter lines from the loaded post, re-emitted on save. */
  let editingExtra: string[] = [];

  const titleInput = document.getElementById('f-title') as HTMLInputElement;
  const descriptionInput = document.getElementById('f-description') as HTMLInputElement;
  const dateInput = document.getElementById('f-date') as HTMLInputElement;
  const categorySelect = document.getElementById('f-category') as HTMLSelectElement;
  const slugInput = document.getElementById('f-slug') as HTMLInputElement;
  const tagsInput = document.getElementById('f-tags') as HTMLInputElement;
  const draftCheckbox = document.getElementById('f-draft') as HTMLInputElement;
  const bodyTextarea = document.getElementById('f-body') as HTMLTextAreaElement;

  const imageBtn = document.getElementById('image-btn') as HTMLButtonElement;
  const imageInput = document.getElementById('image-input') as HTMLInputElement;
  const youtubeBtn = document.getElementById('youtube-btn') as HTMLButtonElement;
  const mermaidBtn = document.getElementById('mermaid-btn') as HTMLButtonElement;
  const linkPreviewBtn = document.getElementById('link-preview-btn') as HTMLButtonElement;

  const bodyCount = document.getElementById('body-count') as HTMLElement;
  const publishBtn = document.getElementById('publish') as HTMLButtonElement;
  const publishStatus = document.getElementById('publish-status') as HTMLElement;

  // No limit is enforced — the count is there so a note that's drifting into
  // post territory is visible while writing it.
  function updateBodyCount() {
    bodyCount.textContent = `${bodyTextarea.value.length.toLocaleString('ko-KR')}자`;
  }
  bodyTextarea.addEventListener('input', updateBodyCount);

  function todayISO(): string {
    const now = new Date();
    const pad = (n: number) => String(n).padStart(2, '0');
    return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  }
  dateInput.value = todayISO();

  /**
   * Stamps the chosen date with the current UTC time-of-day. The time exists
   * purely so two posts published on the same day still sort newest-first —
   * without it their pubDates are identical and the feed falls back to
   * filename order. Deliberately UTC time-of-day pinned to the *selected*
   * date, so the UTC calendar date always matches what was picked and the
   * rendered date (which formats via toISOString) can never drift a day.
   */
  function stampedPubDate(dateValue: string): string {
    const now = new Date();
    const pad = (n: number) => String(n).padStart(2, '0');
    const time = `${pad(now.getUTCHours())}:${pad(now.getUTCMinutes())}:${pad(now.getUTCSeconds())}`;
    return `${dateValue}T${time}Z`;
  }

  // btoa only handles latin1, so UTF-8 text (Korean) has to be escaped first.
  function utf8ToBase64(str: string): string {
    return btoa(unescape(encodeURIComponent(str)));
  }

  // Mirror of utf8ToBase64, for reading a post back out of the Contents API.
  function base64ToUtf8(b64: string): string {
    return decodeURIComponent(escape(atob(b64.replace(/\s/g, ''))));
  }

  interface ParsedPost {
    title: string;
    description: string;
    pubDate: string;
    category: string;
    tags: string[];
    draft: boolean;
    body: string;
    /** Frontmatter keys the form doesn't manage (aiPreview today), kept
     * verbatim so saving an edit doesn't drop them. */
    extra: string[];
  }

  // A small parser tailored to the exact frontmatter shape this page (and the
  // rest of the site's posts) writes — not a general YAML parser.
  function parseFrontmatter(fileContent: string): ParsedPost {
    const match = fileContent.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
    if (!match) throw new Error('invalid-frontmatter');
    const [, frontmatter, body] = match;

    const unquote = (s: string) => s.trim().replace(/^["'](.*)["']$/, '$1');
    const data: Record<string, string> = {};
    for (const line of frontmatter.split('\n')) {
      const fieldMatch = line.match(/^(\w+):\s*(.*)$/);
      if (fieldMatch) data[fieldMatch[1]] = fieldMatch[2];
    }

    const tagsRaw = (data.tags ?? '[]').trim().replace(/^\[/, '').replace(/\]$/, '');
    const tags = tagsRaw
      .split(',')
      .map((t) => unquote(t))
      .filter(Boolean);

    const MANAGED = new Set(['title', 'description', 'pubDate', 'category', 'tags', 'draft']);
    const extra = frontmatter
      .split('\n')
      .filter((line) => {
        const key = line.match(/^(\w+):/)?.[1];
        return key !== undefined && !MANAGED.has(key);
      });

    return {
      extra,
      title: unquote(data.title ?? ''),
      description: unquote(data.description ?? ''),
      pubDate: (data.pubDate ?? '').trim(),
      category: (data.category ?? '').trim(),
      tags,
      draft: (data.draft ?? '').trim() === 'true',
      body: body.replace(/^\n+/, '').replace(/\s+$/, '\n'),
    };
  }

  function slugify(title: string): string {
    const ascii = title
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
    if (ascii) return ascii;
    // Korean-only (or otherwise non-ASCII) titles slugify to nothing — fall
    // back to a timestamp so the commit never collides or 400s on an empty path.
    return `post-${Date.now()}`;
  }

  function yamlString(value: string): string {
    return `"${value.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`;
  }

  // Link-preview data comes from a third-party page's own metadata — never
  // trust it enough to drop straight into the raw HTML the post body allows.
  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function extractYouTubeId(input: string): string | null {
    const trimmed = input.trim();
    if (/^[a-zA-Z0-9_-]{11}$/.test(trimmed)) return trimmed;
    const match = trimmed.match(
      /(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([a-zA-Z0-9_-]{11})/,
    );
    return match ? match[1] : null;
  }

  async function showEditor(login: string) {
    gate.hidden = true;
    editor.hidden = false;
    whoami.textContent = `@${login}로 로그인됨`;
    await loadPostList();

    // A post page's "수정" link lands here as /write?edit=<path> — jump
    // straight into editing that post instead of the blank new-post form.
    const editPath = new URLSearchParams(location.search).get('edit');
    if (editPath) loadPost(editPath);
  }

  function applyKind(next: Kind) {
    kind = next;
    for (const btn of kindButtons) {
      btn.classList.toggle('is-on', btn.dataset.kind === next);
    }
    for (const field of postOnlyFields) {
      field.hidden = next === 'note';
    }
    editor.dataset.kind = next;
    const isNote = next === 'note';
    kindHint.textContent = isNote
      ? '본문만 남깁니다. 수정은 지원하지 않고, 삭제는 /notes에서 합니다.'
      : '제목·카테고리가 있는 정식 글입니다.';
    bodyTextarea.placeholder = isNote
      ? '짧게 남길 내용을 적으세요…'
      : '마크다운으로 본문을 작성하세요…';
    bodyTextarea.rows = isNote ? 6 : 20;
    (postSelect.firstElementChild as HTMLOptionElement).textContent = isNote
      ? '— 새 메모 작성 —'
      : '— 새 글 작성 —';
  }

  for (const btn of kindButtons) {
    btn.addEventListener('click', () => {
      const next = btn.dataset.kind as Kind;
      if (next === kind) return;
      applyKind(next);
      resetForm();
      postSelect.value = '';
      if (next === 'post') loadPostList();
    });
  }

  function resetForm() {
    titleInput.value = '';
    descriptionInput.value = '';
    slugInput.value = '';
    slugInput.readOnly = false;
    tagsInput.value = '';
    draftCheckbox.checked = false;
    bodyTextarea.value = '';
    updateBodyCount();
    dateInput.value = todayISO();
    editingPath = null;
    editingSha = null;
    editingPubDate = null;
    editingExtra = [];
    loadStatus.textContent = '';
    publishBtn.textContent = kind === 'note' ? '메모 남기기' : '발행하기';
  }

  async function loadPostList() {
    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) return;
    try {
      const res = await fetch(`${API_ROOT}/repos/${OWNER}/${REPO}/contents/${DIRS[kind]}`, {
        headers: ghHeaders(token),
      });
      // 404 just means the directory has no files committed yet.
      if (!res.ok) return;
      const files = (await res.json()) as Array<{ name: string; path: string }>;
      const mdFiles = files
        .filter((f) => f.name.endsWith('.md'))
        .sort((a, b) => b.name.localeCompare(a.name));

      const selected = postSelect.value;
      postSelect.replaceChildren();
      const defaultOption = document.createElement('option');
      defaultOption.value = '';
      defaultOption.textContent = kind === 'note' ? '— 새 메모 작성 —' : '— 새 글 작성 —';
      postSelect.appendChild(defaultOption);
      for (const file of mdFiles) {
        const option = document.createElement('option');
        option.value = file.path;
        option.textContent = file.name.replace(/\.md$/, '');
        postSelect.appendChild(option);
      }
      postSelect.value = selected;
    } catch {
      // Listing failure just leaves the dropdown at "새 글 작성" — not fatal.
    }
  }

  async function loadPost(path: string) {
    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) return;

    loadStatus.textContent = '불러오는 중…';
    try {
      const res = await fetch(`${API_ROOT}/repos/${OWNER}/${REPO}/contents/${path}`, {
        headers: ghHeaders(token),
      });
      if (!res.ok) throw new Error(`http-${res.status}`);
      const data = (await res.json()) as { content: string; sha: string };
      const parsed = parseFrontmatter(base64ToUtf8(data.content));

      titleInput.value = parsed.title;
      descriptionInput.value = parsed.description;
      // pubDate may carry a time (see stampedPubDate); <input type="date">
      // only accepts the YYYY-MM-DD part.
      dateInput.value = parsed.pubDate.slice(0, 10) || todayISO();
      categorySelect.value = parsed.category;
      tagsInput.value = parsed.tags.join(', ');
      draftCheckbox.checked = parsed.draft;
      bodyTextarea.value = parsed.body;
      updateBodyCount();
      // Editing keeps the file where it is, so show the slug it already has.
      slugInput.value = path.replace(/^.*\//, '').replace(/\.md$/, '');
      slugInput.readOnly = true;
      editingPath = path;
      editingSha = data.sha;
      editingPubDate = parsed.pubDate;
      editingExtra = parsed.extra;
      postSelect.value = path;
      loadStatus.textContent = `불러옴: ${path}`;
      publishBtn.textContent = '수정 저장';
    } catch {
      loadStatus.textContent = '불러오기 실패. 다시 시도해주세요.';
    }
  }

  postSelect.addEventListener('change', () => {
    const path = postSelect.value;
    if (!path) {
      resetForm();
      return;
    }
    loadPost(path);
  });

  function showGate(message?: string) {
    editor.hidden = true;
    gate.hidden = false;
    if (message) {
      gateStatus.hidden = false;
      gateStatus.textContent = message;
    }
  }

  function clearToken(message?: string) {
    localStorage.removeItem(TOKEN_KEY);
    showGate(message);
  }

  async function init() {
    const stored = localStorage.getItem(TOKEN_KEY);
    if (!stored) {
      showGate();
      return;
    }
    try {
      const login = await validateToken(stored);
      showEditor(login);
    } catch {
      clearToken('저장된 토큰이 더 이상 유효하지 않습니다. 다시 로그인해주세요.');
    }
  }

  gateForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const token = tokenInput.value.trim();
    if (!token) return;
    gateSubmit.disabled = true;
    gateStatus.hidden = false;
    gateStatus.textContent = '확인 중…';
    try {
      const login = await validateToken(token);
      localStorage.setItem(TOKEN_KEY, token);
      tokenInput.value = '';
      showEditor(login);
    } catch (err) {
      const reason = err instanceof Error ? err.message : 'unknown';
      gateStatus.textContent =
        reason === 'wrong-user'
          ? '허용되지 않은 계정입니다.'
          : reason === 'invalid-token'
            ? '토큰이 유효하지 않습니다.'
            : '확인에 실패했습니다. 잠시 후 다시 시도해주세요.';
    } finally {
      gateSubmit.disabled = false;
    }
  });

  logoutBtn.addEventListener('click', () => clearToken());

  // --- Toolbar: wraps/inserts text around the current textarea selection ---
  function wrapSelection(before: string, after: string, placeholder: string) {
    const start = bodyTextarea.selectionStart;
    const end = bodyTextarea.selectionEnd;
    const selected = bodyTextarea.value.slice(start, end) || placeholder;
    const next = bodyTextarea.value.slice(0, start) + before + selected + after + bodyTextarea.value.slice(end);
    bodyTextarea.value = next;
    const cursorStart = start + before.length;
    bodyTextarea.setSelectionRange(cursorStart, cursorStart + selected.length);
    bodyTextarea.focus();
    updateBodyCount();
  }

  function prefixLine(prefix: string) {
    const start = bodyTextarea.selectionStart;
    const lineStart = bodyTextarea.value.lastIndexOf('\n', start - 1) + 1;
    const next = bodyTextarea.value.slice(0, lineStart) + prefix + bodyTextarea.value.slice(lineStart);
    bodyTextarea.value = next;
    const cursor = start + prefix.length;
    bodyTextarea.setSelectionRange(cursor, cursor);
    bodyTextarea.focus();
    updateBodyCount();
  }

  function insertAtCursor(text: string) {
    const start = bodyTextarea.selectionStart;
    const end = bodyTextarea.selectionEnd;
    bodyTextarea.value = bodyTextarea.value.slice(0, start) + text + bodyTextarea.value.slice(end);
    const cursor = start + text.length;
    bodyTextarea.setSelectionRange(cursor, cursor);
    bodyTextarea.focus();
    updateBodyCount();
  }

  document.querySelectorAll<HTMLButtonElement>('.toolbar [data-action]').forEach((btn) => {
    btn.addEventListener('click', () => {
      switch (btn.dataset.action) {
        case 'bold':
          wrapSelection('**', '**', '굵은 텍스트');
          break;
        case 'h2':
          prefixLine('## ');
          break;
        case 'h3':
          prefixLine('### ');
          break;
        case 'h4':
          prefixLine('#### ');
          break;
        case 'code-inline':
          wrapSelection('`', '`', 'code');
          break;
        case 'code-block':
          wrapSelection('\n```\n', '\n```\n', '코드');
          break;
        case 'paragraph':
          insertAtCursor('\n\n');
          break;
      }
    });
  });

  imageBtn.addEventListener('click', () => imageInput.click());

  imageInput.addEventListener('change', async () => {
    const file = imageInput.files?.[0];
    if (!file) return;
    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) return;

    imageBtn.disabled = true;
    imageBtn.textContent = '업로드 중…';
    try {
      const dataUrl = await new Promise<string>((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result as string);
        reader.onerror = () => reject(reader.error);
        reader.readAsDataURL(file);
      });
      const base64 = dataUrl.split(',')[1];
      const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, '-');
      const uploadName = `${Date.now()}-${safeName}`;
      const path = `public/uploads/${uploadName}`;

      const res = await fetch(
        `${API_ROOT}/repos/${OWNER}/${REPO}/contents/${path}`,
        {
          method: 'PUT',
          headers: { ...ghHeaders(token), 'Content-Type': 'application/json' },
          body: JSON.stringify({
            message: `chore: add uploaded image ${safeName}`,
            content: base64,
            branch: BRANCH,
          }),
        },
      );
      if (!res.ok) throw new Error(`upload-failed-${res.status}`);

      insertAtCursor(`![${file.name}](/uploads/${uploadName})`);
    } catch (err) {
      // eslint-disable-next-line no-console
      console.error(err);
      alert('이미지 업로드에 실패했습니다.');
    } finally {
      imageBtn.disabled = false;
      imageBtn.textContent = '🖼 이미지';
      imageInput.value = '';
    }
  });

  youtubeBtn.addEventListener('click', () => {
    const input = prompt('유튜브 영상 URL을 입력하세요');
    if (!input) return;
    const videoId = extractYouTubeId(input);
    if (!videoId) {
      alert('유튜브 URL에서 영상 ID를 찾지 못했습니다.');
      return;
    }
    insertAtCursor(
      `\n<div class="video-embed">\n  <iframe src="https://www.youtube.com/embed/${videoId}" title="YouTube video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>\n</div>\n\n`,
    );
  });

  mermaidBtn.addEventListener('click', () => {
    insertAtCursor(
      '\n```mermaid\ngraph TD\n    A[시작] --> B{조건}\n    B -->|예| C[처리 A]\n    B -->|아니오| D[처리 B]\n```\n\n',
    );
  });

  linkPreviewBtn.addEventListener('click', async () => {
    const input = prompt('미리보기를 만들 링크 URL을 입력하세요');
    if (!input) return;

    let url: URL;
    try {
      url = new URL(input.trim());
    } catch {
      alert('올바른 URL이 아닙니다 (https:// 로 시작해야 합니다).');
      return;
    }

    linkPreviewBtn.disabled = true;
    linkPreviewBtn.textContent = '불러오는 중…';
    try {
      const res = await fetch(`https://api.microlink.io/?url=${encodeURIComponent(url.href)}`);
      if (!res.ok) throw new Error(`http-${res.status}`);
      const json = (await res.json()) as {
        status: string;
        data: { title?: string; description?: string; image?: { url?: string } };
      };
      if (json.status !== 'success') throw new Error('microlink-failed');

      const title = escapeHtml(json.data.title ?? url.hostname);
      const description = escapeHtml(json.data.description ?? '');
      const imageUrl = json.data.image?.url;
      const safeImage = imageUrl && /^https?:\/\//.test(imageUrl) ? escapeHtml(imageUrl) : '';
      const imageStyle = safeImage ? ` style="background-image:url('${safeImage}')"` : '';

      insertAtCursor(
        `\n<a class="link-preview-card" href="${escapeHtml(url.href)}" target="_blank" rel="noopener">\n` +
          `  <div class="link-preview-image"${imageStyle}></div>\n` +
          `  <div class="link-preview-body">\n` +
          `    <span class="link-preview-domain">${escapeHtml(url.hostname)}</span>\n` +
          `    <span class="link-preview-title">${title}</span>\n` +
          `    <span class="link-preview-desc">${description}</span>\n` +
          `  </div>\n` +
          `</a>\n\n`,
      );
    } catch {
      alert('링크 미리보기를 가져오지 못했습니다.');
    } finally {
      linkPreviewBtn.disabled = false;
      linkPreviewBtn.textContent = '🔗 링크 미리보기';
    }
  });

  publishBtn.addEventListener('click', async () => {
    const token = localStorage.getItem(TOKEN_KEY);
    if (!token) {
      clearToken('세션이 만료되었습니다. 다시 로그인해주세요.');
      return;
    }

    const title = titleInput.value.trim();
    const description = descriptionInput.value.trim();
    const body = bodyTextarea.value.trim();
    if (!body) {
      publishStatus.textContent = '본문은 필수입니다.';
      return;
    }
    if (kind === 'post' && (!title || !description)) {
      publishStatus.textContent = '제목, 요약, 본문은 필수입니다.';
      return;
    }

    const tags = tagsInput.value
      .split(',')
      .map((t) => t.trim().toLowerCase())
      .filter(Boolean)
      .filter((tag, index, all) => all.indexOf(tag) === index);

    // Keep the loaded post's exact pubDate when its date wasn't touched, so
    // editing doesn't silently move the post to the top of the feed.
    const pubDate =
      editingPubDate && editingPubDate.slice(0, 10) === dateInput.value
        ? editingPubDate
        : stampedPubDate(dateInput.value);

    const frontmatterLines =
      kind === 'note'
        ? ['---', `pubDate: ${pubDate}`]
        : [
            '---',
            `title: ${yamlString(title)}`,
            `description: ${yamlString(description)}`,
            `pubDate: ${pubDate}`,
            `category: ${categorySelect.value}`,
            `tags: [${tags.map(yamlString).join(', ')}]`,
          ];
    if (draftCheckbox.checked) frontmatterLines.push('draft: true');
    // Carry through anything the form doesn't own — without this, editing a
    // post to fix a typo would silently strip its aiPreview.
    frontmatterLines.push(...editingExtra);
    frontmatterLines.push('---', '');

    const fileContent = `${frontmatterLines.join('\n')}\n${body}\n`;
    const isEdit = editingPath !== null;
    // Notes have no title to slug from, so the timestamp is the filename —
    // which also makes the directory listing sort chronologically.
    // pubDate is `YYYY-MM-DDTHH:MM:SSZ` — reduce it to `YYYY-MM-DD-HHMM`.
    const noteSlug = `${pubDate.slice(0, 10)}-${pubDate.slice(11, 13)}${pubDate.slice(14, 16)}`;
    const typedSlug = slugInput.value.trim();
    let slug: string;
    if (kind === 'note') {
      slug = noteSlug;
    } else if (typedSlug) {
      // slugify() falls back to a timestamp when nothing ASCII survives, which
      // would quietly ignore what was typed — reject it instead.
      slug = slugify(typedSlug);
      if (!/^[a-z0-9-]+$/.test(typedSlug.toLowerCase())) {
        publishStatus.textContent = '슬러그는 영문 소문자·숫자·하이픈만 쓸 수 있습니다.';
        return;
      }
    } else {
      slug = slugify(title);
    }
    const path = editingPath ?? `${DIRS[kind]}/${slug}.md`;
    const label = kind === 'note' ? 'note' : 'post';
    const subject = kind === 'note' ? slug : title;

    publishBtn.disabled = true;
    publishStatus.textContent = isEdit ? '수정 저장 중…' : '발행 중…';
    try {
      const payload: Record<string, unknown> = {
        message: isEdit
          ? `fix: update ${label} "${subject}"`
          : `feat: add ${label} "${subject}"`,
        content: utf8ToBase64(fileContent),
        branch: BRANCH,
      };
      if (isEdit) payload.sha = editingSha;

      const res = await fetch(`${API_ROOT}/repos/${OWNER}/${REPO}/contents/${path}`, {
        method: 'PUT',
        headers: { ...ghHeaders(token), 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.status === 422) {
        publishStatus.textContent = isEdit
          ? '수정 충돌이 발생했습니다. 목록에서 다시 불러온 뒤 시도해주세요.'
          : kind === 'note'
            ? '같은 시각에 남긴 메모가 이미 있습니다. 잠시 후 다시 시도해주세요.'
            : `이미 같은 이름(${slug}.md)의 글이 있습니다. 제목을 바꿔주세요.`;
        return;
      }
      if (res.status === 401) {
        clearToken('토큰이 만료되었거나 취소되었습니다. 다시 로그인해주세요.');
        return;
      }
      if (!res.ok) {
        publishStatus.textContent = `${isEdit ? '수정' : '발행'} 실패 (HTTP ${res.status}).`;
        return;
      }

      const resData = (await res.json()) as { content: { sha: string } };
      publishStatus.innerHTML = `${isEdit ? '수정' : '발행'} 완료! <a href="https://github.com/${OWNER}/${REPO}/actions" target="_blank" rel="noopener">배포 진행 상황 ↗</a>`;

      if (isEdit) {
        // Stay on the same post — just refresh the sha so a second save
        // in a row doesn't 409 against the now-stale one.
        editingSha = resData.content.sha;
      } else {
        resetForm();
        postSelect.value = '';
        loadPostList();
      }
    } catch {
      publishStatus.textContent = '네트워크 오류로 저장에 실패했습니다.';
    } finally {
      publishBtn.disabled = false;
    }
  });

  init();
</script>

