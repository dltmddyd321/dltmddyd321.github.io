---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import ExternalRow from '../components/ExternalRow.astro';
import { SAME_AS, SITE } from '../lib/site';
import { firstImage } from '../lib/postThumbnail';
import tistory from '../data/tistory-archive.json';
import keyflow from '../data/keyflow-archive.json';

const SOURCE_LABELS: Record<string, string> = {
  tistory: 'Tistory',
  keyflow: 'KeyFlow',
};

export const getStaticPaths = (async ({ paginate }) => {
  // Astro hoists getStaticPaths out of component scope, so this can't live in
  // the frontmatter above — it wouldn't be in scope here.
  const PAGE_SIZE = 30;

  const posts = await getCollection('posts', ({ data }) => !data.draft);

  // One feed, two shapes: full post rows for this blog, compact link rows for
  // anything published elsewhere. `sortKey` normalises the two date formats.
  const feed = [
    ...posts.map((post) => ({
      kind: 'post' as const,
      sortKey: post.data.pubDate.toISOString().slice(0, 10),
      post,
    })),
    ...[
      ...tistory.map((entry) => ({ ...entry, source: 'tistory' })),
      ...keyflow.map((entry) => ({ ...entry, source: 'keyflow' })),
    ].map((entry) => ({
      kind: 'external' as const,
      sortKey: entry.date.replaceAll('.', '-'),
      entry,
    })),
  ].sort((a, b) => b.sortKey.localeCompare(a.sortKey));

  return paginate(feed, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const postCount = page.data.filter((item) => item.kind === 'post').length;
const isFirstPage = page.currentPage === 1;

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);

const jsonLd = isFirstPage
  ? {
      '@context': 'https://schema.org',
      '@type': 'Blog',
      '@id': SITE.url,
      name: SITE.name,
      description: SITE.description,
      url: SITE.url,
      inLanguage: 'ko-KR',
      author: {
        '@type': 'Person',
        name: SITE.author,
        url: SITE.url,
        jobTitle: 'Android Engineer',
        sameAs: SAME_AS,
      },
      blogPost: recentPosts.map((post) => ({
        '@type': 'BlogPosting',
        headline: post.data.title,
        description: post.data.description,
        datePublished: post.data.pubDate.toISOString(),
        url: new URL(`/posts/${post.id}/`, SITE.url).href,
      })),
    }
  : undefined;
---

<BaseLayout
  title={isFirstPage ? 'Posts' : `Posts — ${page.currentPage}페이지`}
  fullTitle={isFirstPage ? SITE.name : undefined}
  description={
    isFirstPage
      ? undefined
      : `전체 글 목록 ${page.currentPage}페이지 (${page.total}편 중 ${page.start + 1}–${page.end + 1}번째).`
  }
  statusLine={`$ ls ./posts ./archives | wc -l  →  ${page.total}  [${page.currentPage}/${page.lastPage}]`}
  jsonLd={jsonLd}
  {/* Later pages are link lists with no original content — index page 1 only. */}
  noindex={!isFirstPage}
  withSidebar
>
  <h1 class="sr-only">
    {SITE.name} — 전체 글{isFirstPage ? '' : ` ${page.currentPage}페이지`}
  </h1>

  <section class="list">
    {page.data.length === 0 && <p class="muted">아직 글이 없습니다.</p>}
    {page.data.map((item) =>
      item.kind === 'post' ? (
        <PostRow
          slug={item.post.id}
          title={item.post.data.title}
          description={item.post.data.description}
          pubDate={item.post.data.pubDate}
          category={item.post.data.category}
          tags={item.post.data.tags}
          thumbnail={firstImage(item.post.body)}
        />
      ) : (
        <ExternalRow
          title={item.entry.title}
          url={item.entry.url}
          date={item.entry.date}
          source={item.entry.source}
          sourceLabel={SOURCE_LABELS[item.entry.source] ?? item.entry.source}
        />
      ),
    )}
  </section>

  {page.lastPage > 1 && (
    <nav class="pager mono" aria-label="페이지 이동">
      {page.url.prev ? (
        <a href={page.url.prev} rel="prev">&larr; 이전</a>
      ) : (
        <span class="muted">&larr; 이전</span>
      )}
      <span class="pager-count muted">{page.currentPage} / {page.lastPage}</span>
      {page.url.next ? (
        <a href={page.url.next} rel="next">다음 &rarr;</a>
      ) : (
        <span class="muted">다음 &rarr;</span>
      )}
    </nav>
  )}

  {isFirstPage && postCount === 0 && (
    <p class="hint muted">
      이 페이지에는 다른 플랫폼에 쓴 글이 함께 표시됩니다. 이 블로그에 쓴 글만 보려면 상단
      카테고리를 눌러보세요.
    </p>
  )}
</BaseLayout>

<style>
  .list > :global(.row:first-child) {
    padding-top: 0;
  }

  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 0.82rem;
  }

  .pager-count {
    font-size: 0.76rem;
  }

  .hint {
    margin-top: 24px;
    font-size: 0.85rem;
  }
</style>
