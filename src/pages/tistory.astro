---
import BaseLayout from '../layouts/BaseLayout.astro';
import archive from '../data/tistory-archive.json';

const byYear = new Map();
for (const post of archive) {
  const year = post.date.slice(0, 4);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year).push(post);
}
const years = [...byYear.keys()].sort((a, b) => b.localeCompare(a));
---

<BaseLayout
  title="예전 글 아카이브"
  description={`2022~2026년 Tistory(Win-Dev)에 쓴 Android·Kotlin·알고리즘 글 ${archive.length}편의 색인. 제목으로 검색해 원문으로 바로 이동할 수 있습니다.`}
  statusLine={`$ find ~/tistory -name "*.entry" | wc -l  →  ${archive.length}`}
>
  <section class="hero">
    <p class="kicker mono">&gt; legacy archive</p>
    <h1>예전 글 아카이브</h1>
    <p class="muted">
      이 블로그를 시작하기 전, <a href="https://yongdragon9819.tistory.com" target="_blank" rel="noopener">Tistory(Win-Dev)</a>에
      {archive.length}편의 글을 썼습니다. 새 글은 이제 여기서 이어가지만, 예전 글은 옮기지 않고
      원문 그대로 Tistory에 남겨둔 채 목록만 여기서 찾아볼 수 있게 했습니다. 클릭하면 원문으로
      이동합니다.
    </p>
  </section>

  <div class="search-bar mono">
    <span class="prompt">$ grep -i</span>
    <input
      type="text"
      id="q"
      placeholder="제목으로 검색…"
      autocomplete="off"
      aria-label="예전 글 제목 검색"
    />
    <span class="count muted" id="count">{archive.length} / {archive.length}</span>
  </div>

  <div id="years">
    {years.map((year) => (
      <section class="year-group" data-year={year} data-total={byYear.get(year).length}>
        <h2 class="mono">
          {year} <span class="muted year-count">· {byYear.get(year).length}편</span>
        </h2>
        <ul class="post-list">
          {byYear.get(year).map((post) => (
            <li class="post-item" data-title={post.title.toLowerCase()}>
              <a href={post.url} target="_blank" rel="noopener">
                <span class="date mono muted">{post.date}</span>
                <span class="title">{post.title}</span>
                <span class="go mono muted">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="muted no-result" id="no-result" hidden>검색 결과가 없습니다.</p>
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('q') as HTMLInputElement;
  const countEl = document.getElementById('count')!;
  const noResult = document.getElementById('no-result')!;
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('.post-item'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.year-group'));
  const total = items.length;

  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;

    for (const item of items) {
      const match = !q || (item.dataset.title ?? '').includes(q);
      item.hidden = !match;
      if (match) visible += 1;
    }

    for (const group of groups) {
      const visibleInGroup = group.querySelectorAll('.post-item:not([hidden])').length;
      group.hidden = visibleInGroup === 0;
      const yearCount = group.querySelector('.year-count')!;
      const groupTotal = group.dataset.total;
      yearCount.textContent = q ? `· ${visibleInGroup} / ${groupTotal}편` : `· ${groupTotal}편`;
    }

    countEl.textContent = `${visible} / ${total}`;
    noResult.hidden = visible !== 0;
  });
</script>

<style>
  .hero {
    padding: 8px 0 28px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 24px;
  }

  .kicker {
    color: var(--accent);
    font-size: 0.8rem;
    margin: 0 0 12px;
  }

  h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    margin: 0 0 14px;
  }

  .hero p.muted {
    max-width: 70ch;
    font-size: 1rem;
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 32px;
  }

  .search-bar .prompt {
    color: var(--accent);
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .search-bar input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .search-bar input::placeholder {
    color: var(--text-muted);
  }

  .search-bar .count {
    font-size: 0.78rem;
    flex-shrink: 0;
  }

  .year-group {
    margin-bottom: 36px;
  }

  .year-group h2 {
    font-size: 1rem;
    color: var(--text);
    margin: 0 0 4px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  .year-count {
    font-weight: 400;
    font-size: 0.85rem;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-item a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 11px 4px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }

  .post-item:last-child a {
    border-bottom: none;
  }

  .post-item a:hover {
    text-decoration: none;
    color: var(--accent);
  }

  .post-item a:hover .title {
    text-decoration: underline;
  }

  .post-item .date {
    flex-shrink: 0;
    font-size: 0.78rem;
    width: 6.5em;
  }

  .post-item .title {
    flex: 1;
    min-width: 0;
    overflow-wrap: break-word;
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .post-item .go {
    flex-shrink: 0;
    font-size: 0.8rem;
  }

  .no-result {
    padding: 24px 0;
  }

  @media (max-width: 560px) {
    .search-bar {
      flex-wrap: wrap;
    }

    .search-bar .count {
      width: 100%;
      order: 3;
    }

    .post-item a {
      flex-wrap: wrap;
      gap: 4px 14px;
    }

    .post-item .date {
      width: auto;
    }
  }
</style>
