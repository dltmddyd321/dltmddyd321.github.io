---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" statusLine="$ pagefind --site ./dist">
  <section class="hero">
    <p class="kicker mono">&gt; search</p>
    <h1>글 검색</h1>
    <p class="muted">제목과 본문 전체에서 찾습니다.</p>
  </section>

  <div class="search-bar mono">
    <span class="prompt">$ grep -ri</span>
    <input
      type="text"
      id="q"
      placeholder="검색어 입력…"
      autocomplete="off"
      aria-label="글 검색"
    />
  </div>

  <p class="status muted mono" id="status" hidden></p>
  <ul class="results" id="results"></ul>
</BaseLayout>

<script>
  type PagefindResult = {
    url: string;
    excerpt: string;
    meta: { title?: string };
  };

  type PagefindModule = {
    init: () => Promise<void>;
    search: (query: string) => Promise<{ results: { data: () => Promise<PagefindResult> }[] }>;
  };

  const input = document.getElementById('q') as HTMLInputElement;
  const statusEl = document.getElementById('status')!;
  const resultsEl = document.getElementById('results')!;

  let pagefind: PagefindModule | null = null;
  let ready: Promise<void> | null = null;
  let debounceTimer: ReturnType<typeof setTimeout>;
  let requestId = 0;

  // Hidden inside a Function body, this import() is invisible to Vite's build-time
  // static analysis (which otherwise wraps even @vite-ignore'd dynamic imports with
  // a preload helper that fails since /pagefind/pagefind.js only exists after the
  // postbuild step, not at bundle time).
  const importUnanalyzed = new Function('specifier', 'return import(specifier)') as (
    specifier: string,
  ) => Promise<PagefindModule>;

  function ensurePagefind(): Promise<void> {
    if (!ready) {
      ready = (async () => {
        try {
          pagefind = await importUnanalyzed('/pagefind/pagefind.js');
          await pagefind!.init();
        } catch (e) {
          console.error('pagefind load failed', e);
          pagefind = null;
        }
      })();
    }
    return ready;
  }

  async function runSearch(query: string) {
    const myRequestId = ++requestId;
    resultsEl.innerHTML = '';

    if (!query) {
      statusEl.hidden = true;
      return;
    }

    statusEl.hidden = false;
    statusEl.textContent = '검색 중…';

    await ensurePagefind();
    if (myRequestId !== requestId) return;

    if (!pagefind) {
      statusEl.textContent =
        '검색 색인은 프로덕션 빌드에서만 생성됩니다 (npm run build && npm run preview로 확인하세요).';
      return;
    }

    const search = await pagefind.search(query);
    if (myRequestId !== requestId) return;

    if (search.results.length === 0) {
      statusEl.textContent = '검색 결과가 없습니다.';
      return;
    }

    const items = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));
    if (myRequestId !== requestId) return;

    statusEl.textContent = `${search.results.length}개 결과`;
    resultsEl.innerHTML = items
      .map(
        (item) => `
          <li class="result">
            <a href="${item.url}">
              <span class="title">${item.meta.title ?? item.url}</span>
              <span class="excerpt">${item.excerpt}</span>
            </a>
          </li>
        `,
      )
      .join('');
  }

  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const query = input.value.trim();
    debounceTimer = setTimeout(() => runSearch(query), 200);
  });

  const params = new URLSearchParams(location.search);
  const initial = params.get('q');
  if (initial) {
    input.value = initial;
    runSearch(initial);
  }
</script>

<style>
  .hero {
    padding: 8px 0 28px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 24px;
  }

  .kicker {
    color: var(--accent);
    font-size: 0.8rem;
    margin: 0 0 12px;
  }

  h1 {
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    margin: 0 0 10px;
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 20px;
  }

  .search-bar .prompt {
    color: var(--accent);
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .search-bar input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .search-bar input::placeholder {
    color: var(--text-muted);
  }

  .status {
    font-size: 0.82rem;
    margin: 0 0 16px;
  }
</style>

<style is:global>
  /* Result items are injected via innerHTML at runtime, so Astro's scoped-style
     attribute is never attached to them — these rules must stay unscoped. */
  .results {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .result a {
    display: block;
    padding: 16px 4px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }

  .result a:hover {
    text-decoration: none;
  }

  .result a:hover .title {
    color: var(--accent);
    text-decoration: underline;
  }

  .result .title {
    display: block;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .result .excerpt {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .result .excerpt mark {
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 3px;
    padding: 0 2px;
  }
</style>
