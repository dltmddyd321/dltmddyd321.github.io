---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import { SAME_AS, SITE } from '../lib/site';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': SITE.url,
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
  inLanguage: 'ko-KR',
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
    jobTitle: 'Android Engineer',
    sameAs: SAME_AS,
  },
  blogPost: posts.slice(0, 10).map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    url: new URL(`/posts/${post.id}/`, SITE.url).href,
  })),
};
---

<BaseLayout
  title="Posts"
  fullTitle={`${SITE.name} — Android · Kotlin 개발 기록`}
  statusLine={`$ ls -la ./posts | wc -l  →  ${posts.length}`}
  jsonLd={jsonLd}
  withSidebar
>
  {/* The home page is just the list; the heading stays for document structure
      (a page with no h1 is a screen-reader and SEO regression) but is hidden. */}
  <h1 class="sr-only">{SITE.name} — 전체 글</h1>

  <section class="list">
    {posts.length === 0 && <p class="muted">아직 작성된 글이 없습니다.</p>}
    {posts.map((post) => (
      <PostRow
        slug={post.id}
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        category={post.data.category}
        tags={post.data.tags}
      />
    ))}
  </section>
</BaseLayout>

<style>
  .list > :global(.row:first-child) {
    padding-top: 0;
  }
</style>
