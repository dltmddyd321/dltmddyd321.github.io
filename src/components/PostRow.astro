---
import { categoryLabel } from '../lib/categories';

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  /** First content image found in the post body, if any — shown as a
   * thumbnail at the row's trailing edge. */
  thumbnail?: string;
}

const { slug, title, description, pubDate, category, tags = [], thumbnail } = Astro.props;

const dateStr = pubDate.toISOString().slice(0, 10);
---

<article class="row">
  <div class="row-body">
    <div class="meta mono">
      <span class="date">{dateStr}</span>
      <a class="chip" href={`/category/${category}`}>{categoryLabel(category)}</a>
    </div>
    <a class="title" href={`/posts/${slug}`}>{title}</a>
    <p class="desc muted">{description}</p>
    {tags.length > 0 && (
      <div class="tags mono">
        {tags.map((tag) => (
          <a class="tag" href={`/tag/${tag}`}>#{tag}</a>
        ))}
      </div>
    )}
  </div>
  {thumbnail && (
    <a class="row-thumb" href={`/posts/${slug}`} aria-hidden="true" tabindex="-1">
      <img src={thumbnail} alt="" loading="lazy" width="120" height="80" />
    </a>
  )}
</article>

<style>
  .row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .row-body {
    flex: 1;
    min-width: 0;
  }

  .row:hover .title {
    color: var(--accent);
  }

  .row-thumb {
    flex-shrink: 0;
    display: block;
    width: 120px;
    height: 80px;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .row-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  /* Below this a thumbnail squeezes the text column too hard to read
     comfortably — drop it rather than let the row wrap awkwardly. */
  @media (max-width: 560px) {
    .row-thumb {
      display: none;
    }
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .title {
    display: block;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 6px;
    line-height: 1.35;
  }

  .title:hover {
    text-decoration: none;
  }

  .desc {
    margin: 0;
    font-size: 0.98rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
    font-size: 0.76rem;
  }

  .tags .tag {
    color: var(--text-muted);
  }

  .tags .tag:hover {
    color: var(--accent);
  }
</style>
