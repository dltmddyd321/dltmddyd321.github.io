---
interface Props {
  /** Rendered note body — passed as a slot; this is just the terminal chrome. */
  id: string;
  pubDate: Date;
  /** Sidebar renders a trimmed version: no timestamp row. */
  compact?: boolean;
  /** Long notes are cut short in the list and continue on their own page. */
  clamped?: boolean;
  /** Trim the body to this many lines. Used wherever a note is a preview
   * (sidebar rail, home strip) rather than the note itself. */
  clampLines?: number;
  /** Makes the whole block a link to the note. Rendered as an overlay rather
   * than a wrapper: note bodies contain auto-linked URLs, and an <a> may not
   * nest inside another — the parser closes the outer one and clones it,
   * which littered the home strip with empty phantom cards. */
  href?: string;
  /** Repo-relative path to the note's source file. Supplying it renders a
   * delete control, which only reveals itself once an admin token is present
   * in localStorage (see the /notes script). */
  sourcePath?: string;
}

const { id, pubDate, compact = false, clamped = false, clampLines, href, sourcePath } =
  Astro.props;

// Notes are timestamped to the minute — the whole point is "when did I jot
// this", which a date alone doesn't answer for several notes in one day.
const stamp = pubDate.toISOString().slice(0, 16).replace('T', ' ');
---

<article class:list={['note', { compact, clamped }]} id={id}>
  <div class="note-screen mono">
    <div class="note-body">
      <span class="prompt" aria-hidden="true">$</span>
      <div
        class:list={['note-content', { 'is-clamped': clampLines !== undefined }]}
        style={clampLines !== undefined ? `--clamp-lines: ${clampLines}` : undefined}
      >
        <slot />
      </div>
    </div>

    {clamped && (
      <a class="note-more mono" href={`/notes/${id}`}>더 보기 →</a>
    )}
  </div>

  {!compact && (
    <div class="note-meta mono">
      <a class="stamp" href={`/notes/${id}`}>{stamp}</a>
      {sourcePath && (
        <button type="button" class="note-delete" data-path={sourcePath} hidden>
          🗑 삭제
        </button>
      )}
    </div>
  )}

  {href && <a class="note-cover" href={href} aria-label={`메모 ${stamp}`}></a>}
</article>

<style>
  .note {
    position: relative;
    margin: 0 0 20px;
  }

  .note-cover {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 8px;
  }

  .note:has(.note-cover:hover) .note-screen {
    border-color: var(--accent-line);
  }

  /* The terminal pane itself. Squared-off and flat on purpose — it should read
     as a console window, not as another card in the feed. */
  .note-screen {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px 18px;
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .note-body {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  .prompt {
    color: var(--accent);
    flex-shrink: 0;
    user-select: none;
  }

  .note-content {
    min-width: 0;
    flex: 1;
    color: var(--text);
    /* Notes routinely hold bare URLs. Without this an unbreakable string
       pushes past the box instead of wrapping inside it. */
    overflow-wrap: anywhere;
  }

  /*
   * Trimmed by height rather than -webkit-line-clamp. That property needs the
   * legacy -webkit-box display mode, which mislays multi-block markdown — a
   * note starting with a long URL rendered blank and stretched its card to
   * several hundred px. `lh` is the computed line box, so this tracks whatever
   * line-height the variant sets.
   *
   * A gradient mask would signal the cut more clearly, but it fades the last
   * line of notes that don't reach the limit (nothing in CSS can tell whether
   * the box actually overflowed) and Chrome drops the masked content entirely
   * inside a horizontal scroller. A plain cut is the honest trade.
   */
  .note-content.is-clamped {
    /* em fallback first (line-height is 1.6–1.7 here); `lh` wins where known. */
    max-height: calc(var(--clamp-lines) * 1.7em);
    max-height: calc(var(--clamp-lines) * 1lh);
    overflow: hidden;
  }

  /* Markdown inside a note stays tight — a note is a couple of lines, so the
     usual post spacing would leave the pane mostly empty. */
  .note-content :global(p) {
    margin: 0 0 0.7em;
  }

  .note-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .note-content :global(pre) {
    margin: 0.7em 0;
    font-size: 0.92em;
  }

  .note-content :global(ul),
  .note-content :global(ol) {
    margin: 0.5em 0;
    padding-left: 1.3em;
  }

  /*
   * Caret sits at the end of the note's last line, as it would in a real
   * terminal. It's a pseudo-element on the last block rather than an element
   * of its own so it flows inline with the text instead of starting a line.
   * Lists need the deepest item targeted — `ul::after` would drop below the
   * final bullet rather than trailing its text.
   */
  .note-content > :last-child:not(ul):not(ol)::after,
  .note-content > ul:last-child > li:last-child::after,
  .note-content > ol:last-child > li:last-child::after {
    content: '';
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.35em;
    vertical-align: -0.15em;
    background: var(--accent);
    animation: note-blink 1.1s step-end infinite;
  }

  @keyframes note-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  /* A blinking block is exactly the kind of motion that triggers discomfort —
     keep the caret, drop the flicker. */
  @media (prefers-reduced-motion: reduce) {
    .note-content > :last-child:not(ul):not(ol)::after,
    .note-content > ul:last-child > li:last-child::after,
    .note-content > ol:last-child > li:last-child::after {
      animation: none;
    }
  }

  /* Cut by height so the fold lands on a clean edge; the caret is part of the
     last line, so a clamped note doesn't show one — the "더 보기" link stands
     in for it. */
  .clamped .note-content {
    max-height: calc(8 * 1.7em);
    max-height: calc(8 * 1lh);
    overflow: hidden;
  }

  .note-more {
    display: inline-block;
    margin-top: 10px;
    padding-left: 20px;
    font-size: 0.76rem;
  }

  .note-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-top: 8px;
    padding-left: 4px;
    font-size: 0.72rem;
  }

  .stamp {
    color: var(--text-muted);
  }

  .stamp:hover {
    color: var(--accent);
    text-decoration: none;
  }

  /* Pushed to the trailing edge so it never sits between the timestamp and
     the tags, which read as one meta line. */
  .note-delete {
    margin-left: auto;
    background: transparent;
    border: none;
    padding: 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
  }

  .note-delete:hover {
    color: #d9534f;
  }

  .note-delete:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Sidebar variant: same pane, smaller and quieter. */
  .compact .note-screen {
    padding: 10px 12px;
    font-size: 0.76rem;
    line-height: 1.6;
  }

  .compact .note-body {
    gap: 7px;
  }

  .compact .note-content > :last-child:not(ul):not(ol)::after,
  .compact .note-content > ul:last-child > li:last-child::after,
  .compact .note-content > ol:last-child > li:last-child::after {
    width: 0.5em;
    height: 0.95em;
  }
</style>
